[run]
source = src
# Unit coverage focuses on core/config; GUI/API are covered by
# integration (Robot) and manual QA. CI gate is 60% on unit; 90% is
# aspirational when gui/api are included. Keep omit narrow.
omit =
    src/gui/*
    src/main.py
    src/main_window.py
    src/app.py
    src/api/*

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    raise NotImplementedError
    if __name__ == .__main__.:
show_missing = True
skip_covered = False
