/* ============================================================
   RenodeResilience Light Theme — Professional 2026
   Palette: App #F3F4F6 Card #FFFFFF Sidebar #FAFBFC Border #E5E7EB
   Primary #2563EB Success #059669 Warning #D97706 Error #DC2626 Info #0284C7
   Text #111827 / #6B7280 / #9CA3AF — Inter/Segoe UI, 6px radius
   ============================================================ */

* {
    font-family: "Inter", "Segoe UI", "SF Pro Display", "Ubuntu", sans-serif;
    font-size: 13px;
    color: #111827;
}

QMainWindow, QWidget#centralWidget {
    background: #F3F4F6;
}

/* ── Menu Bar ──────────────────────────────────────────────── */
QMenuBar {
    background: #FAFBFC;
    color: #111827;
    border-bottom: 1px solid #E5E7EB;
    padding: 2px 4px;
}
QMenuBar::item { padding: 6px 12px; border-radius: 6px; }
QMenuBar::item:selected { background: #EFF6FF; color: #2563EB; }
QMenu {
    background: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 6px;
    padding: 4px;
}
QMenu::item { padding: 6px 24px 6px 12px; border-radius: 6px; }
QMenu::item:selected { background: #2563EB; color: #FFFFFF; }
QMenu::separator { height: 1px; background: #E5E7EB; margin: 4px 8px; }

/* ── Dock Widgets ──────────────────────────────────────────── */
QDockWidget {
    background: #FFFFFF;
    font-weight: 600;
    color: #6B7280;
}
QDockWidget::title {
    background: #FAFBFC;
    color: #6B7280;
    padding: 8px 12px;
    border-bottom: 1px solid #E5E7EB;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

/* ── Sidebar (QTreeWidget) ─────────────────────────────────── */
QTreeWidget {
    background: #FAFBFC;
    color: #111827;
    border: none;
    border-right: 1px solid #E5E7EB;
    outline: none;
    font-size: 13px;
    padding: 4px;
}
QTreeWidget::item {
    padding: 7px 8px 7px 16px;
    border-radius: 6px;
    margin: 1px 4px;
}
QTreeWidget::item:selected { background: #EFF6FF; color: #2563EB; }
QTreeWidget::item:hover:!selected { background: #F3F4F6; }
QTreeWidget::branch { background: #FAFBFC; }

/* ── Cards ─────────────────────────────────────────────────── */
QFrame#card {
    background: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 6px;
    padding: 16px;
}
QFrame#card:hover { border-color: #2563EB; }

QFrame#summaryCard {
    background: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 6px;
    padding: 16px;
}
/* QSS cannot do box-shadow; emulate with border - subtle */
QFrame#metricCard {
    background: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 6px;
    padding: 16px;
}

/* ── Tables (FaultTable) ───────────────────────────────────── */
QTableWidget, QTableView {
    background: #FFFFFF;
    alternate-background-color: #F9FAFB;
    color: #111827;
    gridline-color: #E5E7EB;
    border: 1px solid #E5E7EB;
    border-radius: 6px;
    selection-background-color: #EFF6FF;
    selection-color: #111827;
}
QTableWidget::item, QTableView::item {
    padding: 6px 8px;
    border-bottom: 1px solid #F3F4F6;
}
QTableWidget::item:selected, QTableView::item:selected {
    background: #EFF6FF;
    color: #2563EB;
}
QTableWidget::item:hover:!selected {
    background: #F3F4F6;
}
QHeaderView::section {
    background: #FAFBFC;
    color: #6B7280;
    border: none;
    border-bottom: 1px solid #E5E7EB;
    border-right: 1px solid #E5E7EB;
    padding: 8px 10px;
    font-weight: 600;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}
QHeaderView::section:hover { background: #F3F4F6; color: #111827; }

/* ── Buttons ───────────────────────────────────────────────── */
QPushButton {
    background: #2563EB;
    color: #FFFFFF;
    border: none;
    border-radius: 6px;
    padding: 8px 20px;
    font-weight: 600;
    font-size: 13px;
}
QPushButton:hover { background: #1D4ED8; }
QPushButton:pressed { background: #1E40AF; }
QPushButton:disabled { background: #E5E7EB; color: #9CA3AF; }

/* Variants */
QPushButton#ghostBtn {
    background: #FFFFFF;
    color: #374151;
    border: 1px solid #E5E7EB;
}
QPushButton#ghostBtn:hover { background: #F9FAFB; border-color: #9CA3AF; }

QPushButton#stopBtn { background: #DC2626; }
QPushButton#stopBtn:hover { background: #B91C1C; }

QPushButton#exportBtn {
    background: #FFFFFF;
    color: #6B7280;
    border: 1px solid #E5E7EB;
    border-radius: 6px;
    padding: 6px 12px;
    font-size: 12px;
}
QPushButton#exportBtn:hover { background: #F9FAFB; color: #111827; border-color: #D1D5DB; }

/* ── Progress Bar ──────────────────────────────────────────── */
QProgressBar {
    background: #E5E7EB;
    border: none;
    border-radius: 6px;
    height: 8px;
    text-align: center;
    color: transparent;
}
QProgressBar::chunk {
    background: #2563EB;
    border-radius: 6px;
}

/* ── Inputs ────────────────────────────────────────────────── */
QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    background: #FFFFFF;
    color: #111827;
    border: 1px solid #E5E7EB;
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 13px;
    selection-background-color: #EFF6FF;
}
QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus {
    border: 1px solid #2563EB;
}
QLineEdit:disabled, QSpinBox:disabled { background: #F9FAFB; color: #9CA3AF; }

QComboBox::drop-down { border: none; width: 28px; }
QComboBox::down-arrow {
    image: none;
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-top: 6px solid #6B7280;
    margin-right: 8px;
}
QComboBox QAbstractItemView {
    background: #FFFFFF;
    color: #111827;
    border: 1px solid #E5E7EB;
    border-radius: 6px;
    selection-background-color: #EFF6FF;
    padding: 4px;
}
QComboBox QAbstractItemView::item { padding: 6px 10px; border-radius: 4px; }
QComboBox QAbstractItemView::item:selected { background: #EFF6FF; color: #2563EB; }

/* ── Labels ────────────────────────────────────────────────── */
QLabel { color: #111827; background: transparent; }
QLabel#appTitle { font-size: 20px; font-weight: 700; color: #111827; }
QLabel#titleLabel { font-size: 16px; font-weight: 600; color: #111827; }
QLabel#subtitleLabel { font-size: 13px; color: #6B7280; }
QLabel#sectionLabel {
    font-size: 11px;
    font-weight: 600;
    color: #9CA3AF;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}
QLabel#gradeBadge {
    border-radius: 999px;
    padding: 2px 8px;
    font-weight: 700;
    font-size: 12px;
}

/* ── Text Edit (Console) ──────────────────────────────────── */
QTextEdit, QTextBrowser {
    background: #F9FAFB;
    color: #111827;
    border: 1px solid #E5E7EB;
    border-radius: 6px;
    font-family: "JetBrains Mono", "Cascadia Code", "Consolas", monospace;
    font-size: 12px;
    line-height: 1.5;
    padding: 8px;
    selection-background-color: #DBEAFE;
}
QTextEdit:focus { border: 1px solid #E5E7EB; }

/* ── Scroll Bars ───────────────────────────────────────────── */
QScrollBar:vertical { background: #F3F4F6; width: 8px; margin: 0; border: none; }
QScrollBar::handle:vertical { background: #D1D5DB; border-radius: 4px; min-height: 30px; }
QScrollBar::handle:vertical:hover { background: #9CA3AF; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; border: none; background: none; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: #F3F4F6; }
QScrollBar:horizontal { background: #F3F4F6; height: 8px; margin: 0; }
QScrollBar::handle:horizontal { background: #D1D5DB; border-radius: 4px; min-width: 30px; }
QScrollBar::handle:horizontal:hover { background: #9CA3AF; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; background: none; }

/* ── Status Bar ────────────────────────────────────────────── */
QStatusBar {
    background: #FFFFFF;
    color: #6B7280;
    border-top: 1px solid #E5E7EB;
    font-size: 11px;
    padding: 2px 8px;
}
QStatusBar::item { border: none; }
QStatusBar QLabel { color: #6B7280; font-size: 11px; }

/* ── Tab Widget ────────────────────────────────────────────── */
QTabWidget::pane { border: 1px solid #E5E7EB; border-radius: 6px; background: #FFFFFF; }
QTabBar::tab {
    background: #F9FAFB;
    color: #6B7280;
    border: 1px solid #E5E7EB;
    border-bottom: none;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    padding: 8px 20px;
    font-weight: 600;
    font-size: 13px;
}
QTabBar::tab:selected { background: #FFFFFF; color: #2563EB; border-bottom: 2px solid #2563EB; }
QTabBar::tab:hover:!selected { background: #F3F4F6; color: #111827; }

/* ── Splitter ──────────────────────────────────────────────── */
QSplitter::handle { background: #E5E7EB; }
QSplitter::handle:horizontal { width: 1px; }
QSplitter::handle:vertical { height: 1px; }
QSplitter::handle:hover { background: #2563EB; }

/* ── Group Box ─────────────────────────────────────────────── */
QGroupBox {
    background: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 6px;
    margin-top: 12px;
    padding: 16px 12px 12px 12px;
    font-weight: 600;
    color: #111827;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 6px;
    background: #FFFFFF;
    color: #6B7280;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

/* ── Dialog ────────────────────────────────────────────────── */
QDialog { background: #FFFFFF; }

/* ── Check Box ─────────────────────────────────────────────── */
QCheckBox { spacing: 8px; color: #111827; }
QCheckBox::indicator {
    width: 18px; height: 18px;
    border-radius: 6px;
    border: 1.5px solid #D1D5DB;
    background: #FFFFFF;
}
QCheckBox::indicator:checked { background: #2563EB; border-color: #2563EB; }
QCheckBox::indicator:hover { border-color: #2563EB; }
QCheckBox::indicator:disabled { background: #F3F4F6; border-color: #E5E7EB; }

/* ── Tooltip ───────────────────────────────────────────────── */
QToolTip {
    background: #FFFFFF;
    color: #111827;
    border: 1px solid #E5E7EB;
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 12px;
}

/* ── Severity Pills ────────────────────────────────────────── */
QLabel#pillHigh { background: #FEF2F2; color: #DC2626; border: 1px solid #FECACA; border-radius: 999px; padding: 2px 8px; }
QLabel#pillMedium { background: #FFFBEB; color: #D97706; border: 1px solid #FDE68A; border-radius: 999px; padding: 2px 8px; }
QLabel#pillLow { background: #ECFDF5; color: #059669; border: 1px solid #A7F3D0; border-radius: 999px; padding: 2px 8px; }

/* ── Toast ─────────────────────────────────────────────────── */
QFrame#toast {
    background: #111827;
    color: #FFFFFF;
    border-radius: 6px;
    padding: 10px 14px;
    border: none;
}
